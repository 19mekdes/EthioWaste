# ─── EcoBin Environment Template ──────────────────────────────────────

# PostgreSQL (production) — or keep "file:./dev.db" with provider "sqlite" for dev
# Remember to set the provider in prisma/schema.prisma to "postgresql" when using this.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ecobin?schema=public"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# ─── Cloudinary photo uploads ─────────────────────────────────────────
# Docs: https://cloudinary.com/documentation/image_upload_api_reference
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional unsigned preset; when set, signed uploads are skipped
CLOUDINARY_UPLOAD_PRESET=""
